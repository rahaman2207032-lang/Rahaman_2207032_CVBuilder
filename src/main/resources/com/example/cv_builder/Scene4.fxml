<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!-- ROOT: ScrollPane for scrolling -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cv_builder.Scene4Controller"
            fitToWidth="true"
            style="-fx-background-color: #f5f5f5;">

    <!-- CONTENT: VBox inside ScrollPane -->
    <content>
        <VBox spacing="20" style="-fx-background-color: #f5f5f5; -fx-padding: 30;">

            <!-- Header -->
            <HBox alignment="CENTER" style="-fx-background-color: #2c3e50; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="🗄️ Database Management Panel" textFill="white">
                    <font>
                        <Font name="System Bold" size="28"/>
                    </font>
                </Label>
            </HBox>

            <!-- View All CVs Section -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="📋 View All CVs" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Button text="Fetch All CVs" onAction="#handleFetchAll"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"/>
                <ScrollPane prefHeight="200" fitToWidth="true">
                    <TextArea fx:id="allCVsArea" editable="false" wrapText="true"
                              style="-fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                </ScrollPane>
            </VBox>

            <!-- Fetch by ID Section -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="🔍 Fetch CV by ID" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Enter ID:"/>
                    <TextField fx:id="fetchIdField" promptText="e.g., 1" prefWidth="100"/>
                    <Button text="Fetch CV" onAction="#handleFetchById"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"/>
                </HBox>
                <TextArea fx:id="fetchResultArea" editable="false" wrapText="true" prefHeight="150"
                          style="-fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
            </VBox>

            <!-- Update CV Section -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="✏️ Update CV" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <GridPane hgap="10" vgap="10">
                    <Label text="CV ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="updateIdField" promptText="Enter ID" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="updateNameField" promptText="New Name" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="updateEmailField" promptText="New Email" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="updatePhoneField" promptText="New Phone" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="updateAddressField" promptText="New Address" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Education:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <TextField fx:id="updateEducationField" promptText="New Education" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="Skills:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <TextField fx:id="updateSkillsField" promptText="New Skills" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                    <Label text="Experience:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                    <TextField fx:id="updateExperienceField" promptText="New Experience" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                    <Label text="Projects:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                    <TextField fx:id="updateProjectsField" promptText="New Projects" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                </GridPane>

                <HBox spacing="10">
                    <Button text="Load CV Data" onAction="#handleLoadForUpdate"
                            style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"/>
                    <Button text="Update CV" onAction="#handleUpdate"
                            style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"/>
                </HBox>
            </VBox>

            <!-- Delete CV Section -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="🗑️ Delete CV" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Enter ID:"/>
                    <TextField fx:id="deleteIdField" promptText="e. g., 1" prefWidth="100"/>
                    <Button text="Delete CV" onAction="#handleDelete"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"/>
                </HBox>
                <Label fx:id="deleteResultLabel" style="-fx-font-size: 14px;"/>
            </VBox>

            <!-- Back Button -->
            <HBox alignment="CENTER">
                <Button text="⬅️ Back to Home" onAction="#handleBackToHome"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 30;"/>
            </HBox>

        </VBox>
    </content>

</ScrollPane>